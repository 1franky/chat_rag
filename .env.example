# Django
DJANGO_SECRET_KEY=cambiame-usa-python-secrets
DJANGO_DEBUG=0
# Agregá acá cualquier hostname por el que accedas: localhost/127.0.0.1 para
# el túnel SSH, y el dominio si usás un túnel de Cloudflare/reverse proxy
# (ej: chat.tudominio.com). Django devuelve 400 Bad Request si el Host de la
# request no está en esta lista.
ALLOWED_HOSTS=localhost,127.0.0.1
# Mismo criterio que ALLOWED_HOSTS pero con esquema (http/https) — hace
# falta para que el POST de /login/ no falle por CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:3004
# v1 se sirve por HTTP plano (túnel SSH). Si accedés SOLO por un túnel con
# TLS de verdad hasta el navegador (ej. Cloudflare Tunnel), puede ir en 1;
# si accedés por ambas vías, dejalo en 0 (si no, se rompe el login por SSH).
COOKIE_SECURE=0

# Base de datos y storage
DATABASE_URL=sqlite:////data/sqlite/db.sqlite3
MEDIA_ROOT=/data/media

# Redis
REDIS_URL=redis://chat-redis:6379/0

# MCPs
DATA_PLATFORM_MCP_URL=http://data-platform-mcp:8000/mcp
RAG_MCP_URL=http://chat-rag-mcp:8100/mcp

# Qdrant (instancia propia del proyecto)
QDRANT_URL=http://chat-qdrant:6333
QDRANT_COLLECTION=rag_documents

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
MODEL_CACHE_DIR=/app/models

# Claude — solo UNA de estas dos opciones:
# Opción A: usar suscripción (monta ~/.claude en el contenedor, no set API key)
# Opción B: API key (comenta el mount en compose y define aquí)
# ANTHROPIC_API_KEY=sk-ant-...

# El CLI de Claude Code se niega a correr con --dangerously-skip-permissions
# (que chat/agent.py usa siempre, uso 100% personal) si el proceso es root.
# chat-web corre como este uid:gid — tiene que ser el dueño real de ./data/*
# en el host (corré `id -u` / `id -g` ahí para saber cuáles poner).
APP_UID=1000
APP_GID=1000

# UI expose
CHAT_WEB_BIND_ADDRESS=127.0.0.1
CHAT_WEB_PORT=3004

# Logging estructurado (JSON) — chat-web, chat-worker y chat-rag-mcp
# (rag_shared.logging). Docker ya rota estos logs vía el driver json-file
# (ver compose.yaml), no hace falta logrotate aparte.
# LOG_LEVEL=INFO
# JSON_LOGS=0 para logs coloreados legibles en vez de JSON (útil en local).

# Backup (scripts/backup.sh + scripts/install_cron.sh) — retención por
# cantidad Y por tamaño combinado (Fase 9 de plan-v2.md: retener solo por
# antigüedad podía llenar el disco si los backups crecían de tamaño con el
# cron diario ya corriendo). Se conservan como mucho BACKUP_MAX_COUNT
# backups; si esos backups pesan combinados más de BACKUP_MAX_SIZE_MB, se
# borran todos menos el más reciente.
# BACKUP_MAX_COUNT=2
# BACKUP_MAX_SIZE_MB=5120
